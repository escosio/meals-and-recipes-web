# Firebase config for shared household sync. Copy to .env.local for development
# and add the same variables in Vercel (Settings > Environment Variables).
# Leave them unset and the app works on one device only.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project
REACT_APP_FIREBASE_APP_ID=
