# Postgres connection string from Neon (use the pooled one). Needed by the sync
# API, locally and in Vercel's environment variables. Without it the app still
# works on one phone; only sharing is unavailable.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OAuth client ID for "Sign in with Google" (Google Cloud console, APIs &
# Services, Credentials, a "Web application" client). Needed by the API, locally
# and in Vercel. It is public: the API hands it to the page for the button.
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
