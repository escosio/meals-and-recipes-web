rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per household, named by its share code. Anyone signed in
    // (anonymously) who knows the code can read and write it. Codes are
    // random, so keep them private.
    match /households/{code} {
      allow read: if request.auth != null && code.size() >= 6 && code.size() <= 8;
      allow write: if request.auth != null && code.size() >= 6 && code.size() <= 8
        && request.resource.data.keys().hasOnly(['plan', 'routine', 'checked', 'extras', 'createdAt', 'updatedAt']);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
